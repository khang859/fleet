{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-9999-8888-7777-6666-555544443333"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false,
      "headers": {
        "x-api-key": "exa-1234567890abcdef1234567890"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/work"],
      "environment": {
        "FS_ROOT": "/work"
      },
      "enabled": true
    },
    "empty-command": {
      "type": "local",
      "command": []
    }
  }
}
